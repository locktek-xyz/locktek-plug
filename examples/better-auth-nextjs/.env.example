# BetterAuth secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-here

# Public base URL. Without it, callbacks and redirects resolve incorrectly.
BETTER_AUTH_URL=http://localhost:3000

# SQLite database file path (used by the example)
DATABASE_URL=file:./dev.db

# Locktek encryption key — generate with: openssl rand -hex 32
# Required: wallet private keys and mnemonics are encrypted at rest with it.
# Lose this and every wallet it encrypted becomes permanently unspendable.
LOCKTEK_ENCRYPTION_KEY=your-encryption-key-here

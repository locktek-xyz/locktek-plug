{
  "name": "@locktek/mcp-server",
  "version": "0.1.0",
  "description": "Experimental, testnet-only MCP server that gives AI agents a policy-limited wallet — 12 tools, server-held signing key, optional human approval",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "locktek-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@locktek/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "ai-agent",
    "wallet",
    "blockchain",
    "claude",
    "locktek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/locktek-xyz/locktek-plug.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  }
}

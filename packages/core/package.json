{
  "name": "@locktek/core",
  "version": "0.1.0",
  "description": "Experimental, testnet-only wallet SDK for AI agents — HD wallets, encryption, policy engine, and EVM + Tron adapters",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "tronweb": "^6.5.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "wallet",
    "blockchain",
    "ethereum",
    "tron",
    "waas",
    "sdk",
    "hd-wallet",
    "bip44"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/locktek-xyz/locktek-plug.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  }
}
